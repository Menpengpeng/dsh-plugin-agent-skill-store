{
  "name": "@local/dsh-plugin-agent-skill-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Skill 商店：按用途检索 7 个开源 skill 合集，带收藏、评分、笔记与每日增量同步。",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "undici": "^8.12.4",
    "zod": "^4.1.0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "data/*.json",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
